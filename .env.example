SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:5173
DATABASE_URL=postgres://diasorin:diasorin@localhost:5432/diasorin
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
# True for implicit TLS (port 465). Never together with EMAIL_USE_TLS.
EMAIL_USE_SSL=False
# Seconds before an SMTP call gives up
EMAIL_TIMEOUT=20
# Optional. Send every email From this address (real providers reject a From they do not own).
# Takes precedence over the sender address in the Admin Panel.
EMAIL_FROM_OVERRIDE=
# Optional SAFETY NET for testing with a real SMTP server: every email goes ONLY to this address,
# the original recipients are written into the body and the subject is prefixed [TEST -> ...].
# Seed data has real-looking @diasorin.com addresses: set this before pointing at a real server.
EMAIL_REDIRECT_TO=
#
# --- Real SMTP examples (no real credentials here) ---
# Gmail (2-step verification + an App Password):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=<app password>
#   EMAIL_FROM_OVERRIDE=you@gmail.com
#   EMAIL_REDIRECT_TO=you@gmail.com
# Office 365 (SMTP AUTH must be enabled for the mailbox):
#   EMAIL_HOST=smtp.office365.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=shipments@yourcompany.com
#   EMAIL_HOST_PASSWORD=<password>
#   EMAIL_FROM_OVERRIDE=shipments@yourcompany.com
#   EMAIL_REDIRECT_TO=you@yourcompany.com
# SendGrid (the user is literally "apikey"):
#   EMAIL_HOST=smtp.sendgrid.net
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=apikey
#   EMAIL_HOST_PASSWORD=<SendGrid API key>
#   EMAIL_FROM_OVERRIDE=<a verified sender address>
#   EMAIL_REDIRECT_TO=you@yourcompany.com
# SSL variant (port 465): EMAIL_PORT=465, EMAIL_USE_SSL=True, EMAIL_USE_TLS=False
# Check it:  python manage.py send_test_email [--to ADDRESS]
DEFAULT_FROM_EMAIL=noreply-shipments@diasorin.com
MEDIA_ROOT=media
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
TIME_ZONE_DISPLAY=Europe/Rome
